{
    "name": "ross.ch",
    "version": "2.0.0",
    "description": "ross.ch website",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run build:favicon && hugo --minify && npm run build:functions",
        "build:favicon": "node scripts/build-favicon.mjs",
        "build:functions": "wrangler pages functions build --minify --outdir=./dist/worker/",
        "lint": "prettier --check . && eslint . && stylelint \"**/*.scss\"",
        "format": "eslint --fix . && prettier --write . && stylelint --fix \"**/*.scss\"",
        "prepare": "husky",
        "dev": "npm run build:favicon && hugo --logLevel debug server --ignoreCache --disableFastRender",
        "dev:wrangler": "wrangler dev",
        "dev-host": "hugo --logLevel debug server --ignoreCache --disableFastRender --bind 0.0.0.0",
        "test": "vitest",
        "test:coverage": "vitest run --coverage",
        "cf-deploy": "wrangler deploy",
        "cf-dev": "wrangler pages dev",
        "cf-typegen": "wrangler types functions/worker-configuration.d.ts",
        "pre-commit": "lint-staged"
    },
    "keywords": [],
    "author": "Ross Chadwick",
    "license": "GPL-3.0-only",
    "browserslist": [
        "defaults",
        "iOS >= 14",
        "ChromeAndroid >= 119"
    ],
    "devDependencies": {
        "@cloudflare/vitest-pool-workers": "^0.20.3",
        "@eslint/js": "^10.0.1",
        "@fontsource-variable/space-grotesk": "^5.3.0",
        "@fullhuman/postcss-purgecss": "^8.0.0",
        "@htnabe/prettier-plugin-go-template": "^0.0.2",
        "@openpgp/web-stream-tools": "^0.3.1",
        "@resvg/resvg-js": "^2.6.2",
        "@vitest/coverage-istanbul": "^4.1.10",
        "autoprefixer": "^10.5.4",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "lint-staged": "^17.4.1",
        "node-addon-api": "^8.9.1",
        "postcss": "^8.5.26",
        "postcss-calc": "^11.0.1",
        "postcss-cli": "^11.0.1",
        "postcss-preset-env": "^11.3.2",
        "postcss-scss": "^4.0.9",
        "prettier": "^3.9.6",
        "stylelint": "^17.14.1",
        "stylelint-config-standard-scss": "^17.0.0",
        "stylelint-scss": "^7.2.0",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.66.0",
        "vitest": "^4.1.10",
        "wrangler": "^4.120.0"
    },
    "dependencies": {
        "axios": "^1.20.0",
        "openpgp": "^6.3.1",
        "resend": "^6.25.0"
    },
    "lint-staged": {
        "*.{ts,mts,cts,js,mjs,cjs,d.ts}": "eslint --fix",
        "*.{html,json,md,yml,yaml}": "prettier --write",
        "*.scss": "stylelint --fix"
    }
}
